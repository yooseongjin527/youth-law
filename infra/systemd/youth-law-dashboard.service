[Unit]
Description=Youth Law Ops Dashboard (Streamlit, RDS read-only)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/youth_law
Environment=PYTHONPATH=/home/ubuntu/youth_law
ExecStart=/home/ubuntu/youth_law/.venv/bin/streamlit run app/ui_dashboard.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
