# 복사해서 .env로 사용: cp .env.example .env  (커밋 금지)
#
# ★ 이 템플릿은 '로컬 개발' 기본값이다. EC2(프로덕션)와 일부러 다르다:
#     로컬 = chroma + 로깅 off + 트레이싱 youth-law-dev 프로젝트
#     EC2  = pgvector + 로깅 on + 트레이싱 youth-law 프로젝트
#   EC2 .env를 그대로 복사하지 말 것 — RDS는 로컬에서 접근 불가하고
#   프로덕션 로그/트레이스를 오염시킨다.

# --- 데이터 API (docs/API_SETUP.md 절차 참조) ---
LAW_GO_KR_OC=국가법령정보센터_OC값

# --- Bedrock (common/cost.py 티어링) ---
# 팀 리전: us-west-2. 최신 모델은 on-demand 아님 — inference profile ID로 호출.
# ⚠️ 로컬은 IAM 롤이 없으므로 AWS 자격증명을 따로 줘야 Bedrock 호출됨:
#    `aws configure`(액세스키) 또는 SSO. (.env엔 키 안 넣음 — boto3가 ~/.aws에서 읽음)
AWS_REGION=us-west-2
BEDROCK_MODEL_MAIN=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_SMALL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# 테스트/평가가 Bedrock 응답 대기에 오래 묶이지 않게 짧은 기본값 사용
BEDROCK_CONNECT_TIMEOUT=3
BEDROCK_READ_TIMEOUT=12
BEDROCK_MAX_ATTEMPTS=2

# --- RAG 백엔드 — 로컬은 chroma(공짜·오프라인). pgvector는 EC2 전용 ---
# 처음이면: python scripts/build_index.py all  (chroma 4분야 빌드)
RAG_BACKEND=chroma

# --- 웹 상담 세션 ---
# 멀티턴 상담 메모리 TTL(초). 기본 6시간. 0 이하로 두면 TTL 정리를 끈다.
SESSION_TTL_SECONDS=21600

# --- 인프라 연동(RDS/S3) — 로컬은 전부 off ---
# DATABASE_URL은 비워둠: RDS는 EC2 보안그룹 안에서만 접근 + 프로덕션 로그 오염 방지.
# (EC2에서만) 형식: postgresql+psycopg2://<user>:<password>@<rds-endpoint>:5432/youthlaw
DATABASE_URL=
ENABLE_RDS_LOGGING=false
# 한 명이 빌드한 data/·평가결과를 공유하는 버킷 (terraform output / 공유받은 값)
S3_DATA_BUCKET=youth-law-data
ENABLE_S3_SYNC=false

# --- LangSmith 트레이싱 (선택) ---
# ⚠️ 우리 계정은 AWS 호스팅 인스턴스(기본 GCP 아님). 아래가 셋트 — 하나라도 빠지면 403.
#   - API_KEY: 서비스키(lsv2_sk_...) 팀 공유, 여기 빈칸 → 본인 .env에만 채울 것(커밋 금지)
#   - WORKSPACE_ID/ENDPOINT: 비밀 아님(아래 값 그대로 두면 됨)
#   - 로컬은 PROJECT=youth-law-dev 로 둬서 프로덕션 트레이스(youth-law) 오염 방지
# 보고 싶으면 LANGCHAIN_TRACING_V2=true 로만 바꾸면 됨.
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=
LANGSMITH_WORKSPACE_ID=757cdc28-b037-45bf-9468-20d7a6613001
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGCHAIN_ENDPOINT=https://aws.api.smith.langchain.com
LANGCHAIN_PROJECT=youth-law-dev
