# 복사해서 .env로 사용: cp .env.example .env  (한 명이 채워 팀 공유, 커밋 금지)

# --- 데이터 API (docs/API_SETUP.md 절차 참조) ---
LAW_GO_KR_OC=국가법령정보센터_OC값

# --- 데이터 공유 (S3, 선택 — scripts/sync_data.py) ---
# 한 명이 빌드한 data/·평가결과를 팀이 공유하는 공용 버킷명 (한 명이 생성 후 공유)
S3_DATA_BUCKET=youth-law-data

# --- Bedrock (common/cost.py 티어링) ---
# 팀 리전: us-west-2 (서울/도쿄/오사카/싱가포르 선점됨. 모델 가용성·inference profile 기준 선택)
AWS_REGION=us-west-2
# 최신 모델은 on-demand 아님 — inference profile ID로 호출 (검증 완료)
BEDROCK_MODEL_MAIN=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_SMALL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- LangSmith 트레이싱 (Day 2, 실제 키 받은 뒤 true로 — 그 전엔 false 유지) ---
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=smith.langchain.com에서_발급
LANGCHAIN_PROJECT=youth-law

# --- 인프라 연동: RDS / S3 (선택 — 미설정 시 로컬 동작 그대로, 로깅·동기화만 건너뜀) ---
# RDS PostgreSQL 상담/비용/평가 로그 저장용. 비밀번호 포함되므로 .env는 커밋 금지.
# 둘 다 있어야 켜짐(no-op 폴백). 형식: postgresql+psycopg://<user>:<password>@<rds-endpoint>:5432/youthlaw
DATABASE_URL=
# S3 산출물 백업 버킷 (terraform output s3_bucket 값)
S3_BUCKET=
# true일 때만 상담/비용/평가 결과를 RDS에 기록 (DATABASE_URL도 있어야 함)
ENABLE_RDS_LOGGING=false
# true일 때만 data/·evals/ 산출물을 S3로 sync
ENABLE_S3_SYNC=false

# --- RAG 백엔드 선택 (common/rag.py · pipeline/gold.py 한 쌍) ---
# chroma  : 로컬 파일 벡터DB (기본) — 공짜·오프라인. 일상 개발/CI는 이걸로.
# pgvector: RDS PostgreSQL + pgvector(law_chunks) — "한 DB 통합" 데모용. DATABASE_URL(위) 필요.
#           같은 silver·같은 임베딩이라 검색 결과는 동일. 인덱싱도 자동으로 pgvector로 적재.
RAG_BACKEND=chroma
